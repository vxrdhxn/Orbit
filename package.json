{
  "name": "orbit-ai",
  "displayName": "Orbit AI",
  "description": "A VS Code extension providing agentic AI chat features offline, online, and via custom API keys",
  "version": "2.1.0",
  "publisher": "vxrdhxn",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0b0e17",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vxrdhxn/Orbit.git"
  },
  "bugs": {
    "url": "https://github.com/vxrdhxn/Orbit/issues"
  },
  "homepage": "https://github.com/vxrdhxn/Orbit#readme",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "orbit.chat",
        "title": "Orbit: Open Chat"
      },
      {
        "command": "orbit.inlineChange.acceptAll",
        "title": "Orbit: Accept All Proposed Changes"
      },
      {
        "command": "orbit.inlineChange.rejectAll",
        "title": "Orbit: Reject All Proposed Changes"
      },
      {
        "command": "orbit.explain",
        "title": "Orbit: Explain Selection"
      },
      {
        "command": "orbit.search",
        "title": "Orbit: Search Codebase"
      },
      {
        "command": "orbit.indexWorkspace",
        "title": "Orbit: Index Workspace for Semantic Search"
      },
      {
        "command": "orbit.indexCurrentFile",
        "title": "Orbit: Update Semantic Index for Current File"
      },
      {
        "command": "orbit.review",
        "title": "Orbit: Review Code"
      },
      {
        "command": "orbit.edit",
        "title": "Orbit: Edit Code"
      },
      {
        "command": "orbit.health",
        "title": "Orbit: Health Check"
      },
      {
        "command": "orbit.analyzePerformance",
        "title": "Orbit: Analyze Algorithmic Performance",
        "category": "Orbit"
      },
      {
        "command": "orbit.pilot.toggle",
        "title": "Orbit: Toggle Pilot Mode",
        "category": "Orbit"
      },
      {
        "command": "orbit.pilot.undo",
        "title": "Orbit: Undo Last Pilot Fix",
        "category": "Orbit"
      },
      {
        "command": "orbit.sync.export",
        "title": "Orbit: Export Journal to Workspace",
        "category": "Orbit"
      },
      {
        "command": "orbit.sync.import",
        "title": "Orbit: Import Journal from Workspace",
        "category": "Orbit"
      },
      {
        "command": "orbit.viewDecisionHistory",
        "title": "Orbit: View Decision History"
      },
      {
        "command": "orbit.toggleMode",
        "title": "Orbit: Toggle Online/Offline Mode"
      },
      {
        "command": "orbit.showFindings",
        "title": "Orbit: Show Findings"
      },
      {
        "command": "orbit.viewReasoning",
        "title": "Orbit: View AI Reasoning"
      }
    ],
    "keybindings": [
      {
        "command": "orbit.inlineChange.acceptAll",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && orbit.inlineChangePending"
      },
      {
        "command": "orbit.inlineChange.rejectAll",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "editorTextFocus && orbit.inlineChangePending"
      },
      {
        "command": "orbit.chat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "orbit.explain",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "orbit.analyzePerformance",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "orbit.viewDecisionHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orbit-sidebar",
          "title": "Orbit AI",
          "icon": "resources/orbit-activity.svg"
        }
      ]
    },
    "views": {
      "orbit-sidebar": [
        {
          "type": "webview",
          "id": "orbit.chatView",
          "name": "Chat",
          "icon": "resources/orbit-activity.svg"
        }
      ]
    },
    "configuration": {
      "title": "Orbit AI",
      "properties": {
        "orbit.mode": {
          "type": "string",
          "enum": [
            "cloud",
            "custom",
            "offline",
            "local-server",
            "groq",
            "openrouter"
          ],
          "enumItemLabels": [
            "Cloud (Default)",
            "Custom",
            "Offline",
            "Local Server",
            "Groq",
            "OpenRouter"
          ],
          "default": "cloud",
          "description": "Operation mode for Orbit AI (cloud: Default free pool, groq: Groq Free Tier, openrouter: OpenRouter Free Models, custom: Bring Your Own API, offline: Local execution, local-server: Local Server)"
        },
        "orbit.onlineApiEndpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible endpoint for the Custom API Provider (Mode 2)"
        },
        "orbit.onlineApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for the Custom API Provider (Mode 2)"
        },
        "orbit.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Groq (Fast Free Tier - Get it at console.groq.com)"
        },
        "orbit.openRouterApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for OpenRouter (Free Models - Get it at openrouter.ai)"
        },
        "orbit.onlineModel": {
          "type": "string",
          "default": "llama-3.3-70b-specdec",
          "description": "Model ID to use for the Custom API Provider (Mode 2) (e.g., llama-3.3-70b-specdec, gpt-4o)"
        },
        "orbit.offlineModel": {
          "type": "string",
          "default": "Qwen2.5-Coder-7B",
          "description": "Model to use for Offline Execution (Mode 3) (e.g., Qwen2.5-Coder-7B)"
        },
        "orbit.localServerEndpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "Endpoint for the local inference server (e.g., LM Studio or vLLM)"
        },
        "orbit.localServerModel": {
          "type": "string",
          "default": "local-model",
          "description": "Model ID to use for the local inference server"
        },
        "orbit.reasoning.maxRetries": {
          "type": "number",
          "default": 3,
          "description": "Extra attempts when an edit proposal is missing its diff or its structured reasoning."
        },
        "orbit.reasoning.fallbackToRaw": {
          "type": "boolean",
          "default": true,
          "description": "Keep a valid diff with plain-text reasoning when the structured reasoning never parses."
        },
        "orbit.context.maxTokens": {
          "type": "number",
          "default": 4000,
          "description": "Maximum number of tokens to include in AI context"
        },
        "orbit.context.includeDecisions": {
          "type": "boolean",
          "default": true,
          "description": "Include past decisions in the AI context"
        },
        "orbit.decisionJournal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record new decisions in the Decision Journal. Existing history stays viewable when off."
        },
        "orbit.decisionJournal.maxHistoryItems": {
          "type": "number",
          "default": 50,
          "description": "Number of decisions the history view loads at a time."
        },
        "orbit.pilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Orbit Pilot for proactive background analysis and auto-fixes"
        },
        "orbit.pilot.autoFixLevel": {
          "type": "string",
          "enum": [
            "none",
            "suggestion",
            "info"
          ],
          "default": "none",
          "description": "Level of findings to automatically fix"
        },
        "orbit.sync.enableWorkspaceSync": {
          "type": "boolean",
          "default": false,
          "description": "Re-import .orbit/journal.jsonl automatically whenever it changes."
        },
        "orbit.sync.method": {
          "type": "string",
          "enum": [
            "file",
            "git"
          ],
          "default": "file",
          "description": "Method to use for team sync. 'file' writes .orbit/journal.jsonl in the workspace. 'git' shares the journal on a separate 'orbit-journal' branch without touching your own branches or uncommitted work."
        },
        "orbit.embedding.model": {
          "type": "string",
          "default": "Xenova/all-MiniLM-L6-v2",
          "description": "Model ID to use for offline semantic embeddings (e.g. Xenova/all-MiniLM-L6-v2, Xenova/nomic-embed-text-v1.5)"
        },
        "orbit.prIntegration.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PR Integration (connect AI review directly to Git branches/PRs if git extension is available)"
        },
        "orbit.customReviewPresets": {
          "type": "array",
          "default": [],
          "description": "Custom review presets.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique identifier for the preset"
              },
              "displayName": {
                "type": "string",
                "description": "Display name in the QuickPick menu"
              },
              "description": {
                "type": "string",
                "description": "Brief description of the preset"
              },
              "icon": {
                "type": "string",
                "description": "Icon to show in the menu (e.g. an emoji)"
              },
              "config": {
                "type": "object",
                "properties": {
                  "enabledCategories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "minSeverity": {
                    "type": "string"
                  },
                  "maxFindings": {
                    "type": "number"
                  },
                  "includeContext": {
                    "type": "boolean"
                  },
                  "timeoutMs": {
                    "type": "number"
                  },
                  "promptModifiers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "orbit.review.enabledCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bug",
              "security",
              "performance",
              "style",
              "maintainability",
              "bestPractice"
            ]
          },
          "default": [
            "bug",
            "security",
            "performance"
          ],
          "description": "Finding categories Orbit Pilot reports in the background. An empty list reports every category."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "build-all": "npm run compile && npm run build:ui",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test:e2e": "node ./out/src/test/runTest.js",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "build:ui": "npm run build --prefix webview-ui",
    "watch:ui": "npm run watch --prefix webview-ui"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "mocha": "^11.7.6",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "diff": "^9.0.0",
    "node-llama-cpp": "^3.18.1"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "chat",
    "offline",
    "local llm",
    "code review",
    "copilot alternative",
    "llama",
    "qwen",
    "semantic search"
  ]
}
