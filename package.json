{
  "name": "orbit",
  "displayName": "Orbit",
  "description": "Offline-first AI coding assistant",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "orbit.chat",
        "title": "Orbit: Open Chat"
      },
      {
        "command": "orbit.explain",
        "title": "Orbit: Explain Selection"
      },
      {
        "command": "orbit.search",
        "title": "Orbit: Search Codebase"
      },
      {
        "command": "orbit.review",
        "title": "Orbit: Review Code"
      },
      {
        "command": "orbit.edit",
        "title": "Orbit: Edit Code"
      },
      {
        "command": "orbit.health",
        "title": "Orbit: Health Check"
      },
      {
        "command": "orbit.analyzePerformance",
        "title": "Orbit: Analyze Performance"
      }
    ],
    "keybindings": [
      {
        "command": "orbit.analyzePerformance",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orbit-sidebar",
          "title": "Orbit",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "orbit-sidebar": [
        {
          "type": "webview",
          "id": "orbit.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Orbit",
      "properties": {
        "orbit.onlineApiEndpoint": {
          "type": "string",
          "default": "",
          "description": "Endpoint for the Online AI Provider"
        },
        "orbit.onlineApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for the Online AI Provider"
        },
        "orbit.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Endpoint for local Ollama service"
        },
        "orbit.preferOnline": {
          "type": "boolean",
          "default": true,
          "description": "Prefer online provider when available"
        },
        "orbit.ollamaModel": {
          "type": "string",
          "default": "codellama",
          "description": "Model to use for Ollama (e.g., codellama, llama2, mistral)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.11",
    "@types/node": "18.x",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vite": "^5.0.11",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "better-sqlite3": "^12.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
