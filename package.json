{
  "name": "offline-dev-assistant",
  "displayName": "Offline Dev Assistant",
  "description": "Local, offline-first AI assistant for VS Code powered by Ollama.",
  "version": "0.0.3",
  "publisher": "you",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:offlineDevAssistant.healthCheck",
    "onCommand:offlineDevAssistant.explainSelection",
    "onCommand:offlineDevAssistant.search",
    "onCommand:offlineDevAssistant.editCode",
    "onView:offlineDevAssistant.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "offline-dev-assistant-sidebar",
          "title": "Offline Dev Assistant",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "offline-dev-assistant-sidebar": [
        {
          "type": "webview",
          "id": "offlineDevAssistant.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      { "command": "offlineDevAssistant.healthCheck", "title": "AI Assistant: Health Check (Ollama)" },
      { "command": "offlineDevAssistant.explainSelection", "title": "AI Assistant: Explain Selection (Local)" },
      { "command": "offlineDevAssistant.search", "title": "AI Assistant: Search Code (Local)" },
      { "command": "offlineDevAssistant.editCode", "title": "AI Assistant: Edit Code (Unified Diff, Local)" }
    ],
    "configuration": {
      "type": "object",
      "title": "Offline Dev Assistant",
      "properties": {
        "offlineDevAssistant.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Your local Ollama server URL."
        },
        "offlineDevAssistant.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model to use for code tasks (must be pulled in Ollama)."
        },
        "offlineDevAssistant.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Lower = more deterministic outputs."
        },
        "offlineDevAssistant.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Embedding model to use via Ollama (e.g., nomic-embed-text or bge-small-en)."
        },
        "offlineDevAssistant.indexIncludeGlobs": {
          "type": "array",
          "default": ["**/*.{ts,tsx,js,jsx,py,java,go,rs,cpp,c,cs,md}"],
          "items": { "type": "string" },
          "description": "Glob patterns to include for indexing."
        },
        "offlineDevAssistant.indexExcludeGlobs": {
          "type": "array",
          "default": ["**/node_modules/**", "**/.git/**", "**/out/**", "**/dist/**", "**/.devmind/**"],
          "items": { "type": "string" },
          "description": "Glob patterns to exclude from indexing."
        },
        "offlineDevAssistant.indexMaxCharsPerChunk": {
          "type": "number",
          "default": 1200,
          "description": "Max characters per chunk."
        },
        "offlineDevAssistant.indexOverlapChars": {
          "type": "number",
          "default": 200,
          "description": "Overlap between adjacent chunks."
        },
        "offlineDevAssistant.searchTopK": {
          "type": "number",
          "default": 5,
          "description": "Top-K results to return for semantic search."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
