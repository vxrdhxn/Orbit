{
  "name": "orbit",
  "displayName": "Orbit",
  "description": "Always watching your code",
  "version": "0.0.4",
  "publisher": "orbit-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/orbit-user/orbit-vscode.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "offlineDevAssistant-sidebar",
          "title": "Orbit",
          "icon": "resources/orbit.svg"
        },
        {
          "id": "orbit-sidebar",
          "title": "Orbit",
          "icon": "resources/orbit-icon.png"
        },
        {
          "id": "orbit-corrections",
          "title": "Corrections",
          "icon": "resources/orbit-icon.png"
        }
      ]
    },
    "views": {
      "offlineDevAssistant-sidebar": [
        {
          "type": "webview",
          "id": "offlineDevAssistant.chatView",
          "name": "Chat",
          "icon": "resources/orbit.svg"
        }
      ],
      "orbit-sidebar": [
        {
          "type": "webview",
          "id": "orbit.chatView",
          "name": "Chat"
        }
      ],
      "orbit-corrections": [
        {
          "type": "webview",
          "id": "orbit.correctionPanel",
          "name": "Issues"
        }
      ]
    },
    "commands": [
      {
        "command": "offlineDevAssistant.healthCheck",
        "title": "Orbit: Health Check"
      },
      {
        "command": "offlineDevAssistant.explainSelection",
        "title": "Orbit: Explain Selection"
      },
      {
        "command": "offlineDevAssistant.search",
        "title": "Orbit: Search Codebase"
      },
      {
        "command": "offlineDevAssistant.editCode",
        "title": "Orbit: Edit Code (Diff)"
      },
      {
        "command": "devmind.reviewCode",
        "title": "Orbit: Review Code",
        "category": "Orbit"
      },
      {
        "command": "devmind.reviewDiff",
        "title": "Orbit: Review Git Changes",
        "category": "Orbit"
      },
      {
        "command": "devmind.newChat",
        "title": "New Chat",
        "icon": "$(add)"
      },
      {
        "command": "devmind.history",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "devmind.customizations",
        "title": "Customizations"
      },
      {
        "command": "devmind.mcpServers",
        "title": "MCP Servers"
      },
      {
        "command": "devmind.downloadDiagnostics",
        "title": "Download Diagnostics"
      },
      {
        "command": "devmind.export",
        "title": "Export"
      },
      {
        "command": "devmind.closeView",
        "title": "Close",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devmind.newChat",
          "when": "view == offlineDevAssistant.chatView",
          "group": "navigation"
        },
        {
          "command": "devmind.history",
          "when": "view == offlineDevAssistant.chatView",
          "group": "navigation"
        },
        {
          "command": "devmind.closeView",
          "when": "view == offlineDevAssistant.chatView",
          "group": "navigation"
        },
        {
          "command": "devmind.customizations",
          "when": "view == offlineDevAssistant.chatView"
        },
        {
          "command": "devmind.mcpServers",
          "when": "view == offlineDevAssistant.chatView"
        },
        {
          "command": "devmind.downloadDiagnostics",
          "when": "view == offlineDevAssistant.chatView"
        },
        {
          "command": "devmind.export",
          "when": "view == offlineDevAssistant.chatView"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Orbit",
      "properties": {
        "offlineDevAssistant.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Your local Ollama server URL."
        },
        "offlineDevAssistant.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model to use for code tasks (must be pulled in Ollama)."
        },
        "offlineDevAssistant.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Lower = more deterministic outputs."
        },
        "offlineDevAssistant.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Embedding model to use via Ollama (e.g., nomic-embed-text or bge-small-en)."
        },
        "offlineDevAssistant.indexIncludeGlobs": {
          "type": "array",
          "default": [
            "**/*.{ts,tsx,js,jsx,py,java,go,rs,cpp,c,cs,md}"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to include for indexing."
        },
        "offlineDevAssistant.indexExcludeGlobs": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/out/**",
            "**/dist/**",
            "**/.devmind/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to exclude from indexing."
        },
        "offlineDevAssistant.indexMaxCharsPerChunk": {
          "type": "number",
          "default": 1200,
          "description": "Max characters per chunk."
        },
        "offlineDevAssistant.indexOverlapChars": {
          "type": "number",
          "default": 200,
          "description": "Overlap between adjacent chunks."
        },
        "offlineDevAssistant.searchTopK": {
          "type": "number",
          "default": 5,
          "description": "Top-K results to return for semantic search."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "mocha out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "fast-check": "^4.3.0",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.43",
    "@vscode/webview-ui-toolkit": "^1.4.0"
  }
}
